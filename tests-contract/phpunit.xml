<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.3/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Test Suite">
            <directory suffix="Test.php">./tests</directory>
        </testsuite>
    </testsuites>
    <groups>
        <!-- CampaignsTest's "smoke" group hits a historical legacy fixture
             row (id=4, "qbrtcz2") that only exists on the shared legacy
             database, not a fresh DB or new-backend install: excluded from
             the default run so a plain pest run is green against either
             target out of the box. Run it explicitly (pass the group flag
             for "smoke") against the legacy target when you want that
             connectivity sanity check. -->
        <exclude>
            <group>smoke</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory suffix=".php">./app</directory>
            <directory suffix=".php">./src</directory>
        </include>
    </source>
</phpunit>
