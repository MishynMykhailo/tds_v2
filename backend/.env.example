APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Signs/verifies the legacy-compat "states" auth cookie JWT
# (App\Services\AuthService). Installation-specific secret — does NOT need to
# match the old backend's key byte-for-byte, only the JWT token structure is
# a compat requirement. See config/app.php ('jwt_secret').
JWT_SECRET=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis, not phpredis - no PHP redis extension is installed anywhere in
# this project's Docker images (deploy/Dockerfile.dev-php); traffic-core
# already uses predis/predis for the same reason (TrafficCore\Redis\
# RedisClient's own docblock). Found live 2026-09-03 while adding
# App\Console\Commands\PruneHitLimits - the phpredis setting had been here
# unused/unexercised since this .env was created (QUEUE_CONNECTION/
# CACHE_STORE/SESSION_DRIVER are all `database`, not redis), so nothing
# was actually broken by it until this command needed a real Redis client.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# traffic-core preview endpoint (public/preview.php) — see config/services.php.
# PREVIEW_SECRET must match traffic-core's PREVIEW_SECRET env var exactly.
TRAFFIC_CORE_URL=http://localhost:8080
PREVIEW_SECRET=change-me-in-production

# Headless-Chrome CDP endpoint (deploy/docker-compose.yml `screenshot` service).
SCREENSHOT_CDP_URL=http://localhost:9222
